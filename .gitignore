# ---------------------------------------------------------------------------
# Credentials and personal data.
#
# This repository is public. general_config.toml holds a Brawl Stars API token
# and a player tag, login.toml and webhook_config.toml hold keys, and
# match_history.csv is a record of somebody's actual matches. Templates for the
# config files are committed as *.example.toml instead.
# ---------------------------------------------------------------------------
cfg/general_config.toml
cfg/login.toml
cfg/webhook_config.toml
cfg/match_history.csv
debug_view_worker.log

# Gameplay recordings used by tools/dodge_tune.py. Hundreds of megabytes each,
# three of them over GitHub's 100 MB hard limit, and none of them source.
tools/*.mp4
tools/*.mkv
tools/*.avi


# Written by the installer on every run.
install_log.txt

# Written by tools/updater.py: the commit this folder is currently at, and the
# copies it takes of anything it replaces.
.vvok_version
backup_before_update/

# Packaging metadata, regenerated by setuptools on every build.
PylaAI.egg-info/

# Rendered by tools/dodge_animation.py on demand; not worth shipping.
docs/*.gif

# The panel login. Machine-specific, and holds the session-signing key.
cfg/panel_auth.toml
